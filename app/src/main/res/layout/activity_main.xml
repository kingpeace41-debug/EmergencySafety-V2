<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_emergency"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- KURT LOGOSU -->
        <ImageView
            android:id="@+id/wolfLogo"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="0dp"
            android:contentDescription="Emergency Safety kurt kalkanı"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:src="@drawable/wolf_passive" />

        <!-- ÜÇ GÖRSELLİ BUTON -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="3">

            <!-- KIRMIZI ACİL DURUM -->
            <FrameLayout
                android:id="@+id/btnRedAlert"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Acil durum">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/button_red"
                    android:scaleType="fitCenter"
                    android:contentDescription="Acil durum kırmızı butonu"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <!-- SARI UYARI -->
            <FrameLayout
                android:id="@+id/btnYellowAlert"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Uyarı">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/button_yellow"
                    android:scaleType="fitCenter"
                    android:contentDescription="Uyarı sarı butonu"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <!-- MAVİ BİLGİ -->
            <FrameLayout
                android:id="@+id/btnGreenAlert"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Bilgi">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/button_blue"
                    android:scaleType="fitCenter"
                    android:contentDescription="Bilgi mavi butonu"
                    android:importantForAccessibility="no" />
            </FrameLayout>

        </LinearLayout>

        <!-- ALT AYIRICI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#55FFFFFF" />

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Yıldırım simgesi"
                android:src="@drawable/emergency_lightning" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#55FFFFFF" />
        </LinearLayout>

        <!-- ALT SLOGAN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Küçük bir dokunuş,\nbüyük bir fark yaratabilir."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- DİNLEME ŞALTERİ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnToggleListening"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#F2F4F7"
            app:cardCornerRadius="27dp"
            app:cardElevation="6dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Dinleme Şalteri"
                android:src="@android:drawable/ic_lock_power_off"
                app:tint="#222222" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
